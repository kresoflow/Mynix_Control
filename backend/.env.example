# ══════════════════════════════════════════════════════════
# Mynix Control — Environment Variables
# Copy to .env and adjust as needed
# ══════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────
APP_NAME="Mynix Control"
DEBUG=true

# ── PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mynix:mynix_secret@localhost:5432/mynix_control
DATABASE_URL_SYNC=postgresql+psycopg2://mynix:mynix_secret@localhost:5432/mynix_control

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ──────────────────────────────────────────────────
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-LONG-RANDOM-STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Seed defaults ────────────────────────────────────────
OWNER_DEFAULT_USERNAME=owner
OWNER_DEFAULT_PASSWORD=mynix2025
